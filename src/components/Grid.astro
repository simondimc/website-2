---
import ProjectCard from './ProjectCard.astro';
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p: any) => <ProjectCard project={p} />)}
</div>
<style>
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
</style>
