---
import { Image } from 'astro:assets';
import { categories } from '../content.config';
import { coverFor } from '../lib';

const { project } = Astro.props;
const { title, category, year, summary, cover } = project.data;
const img = coverFor(project.id, cover);
---
<a class="section card" href={`/projekti/${project.id}/`}>
  <div class="thumb">
    {img ? <Image src={img.src} alt={title} widths={[400, 700, 1000]} sizes="(min-width: 900px) 320px, 90vw" /> : <div class="empty" />}
  </div>
  <span class="section-title">{title}</span>
  <span class="muted small">{categories[category as keyof typeof categories]} · {year}</span>
  <p class="small">{summary}</p>
</a>
<style>
  .card { display: block; text-decoration: none; }
  .card:hover { background-color: var(--bg); }
  .thumb { aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid black; border-radius: 3px; margin-bottom: 8px; background: var(--bg); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .section-title { margin-bottom: 0; }
  .small { font-size: 14px; }
  .empty { width: 100%; height: 100%; background: repeating-linear-gradient(45deg, transparent 0 8px, rgb(0 0 0 / .04) 8px 16px); }
  p { margin-top: 4px; }
</style>
