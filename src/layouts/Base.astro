---
import '../styles/global.css';
import { categories } from '../content.config';
import { url } from '../lib';

interface Props { title?: string; description?: string }
const { title, description = 'Portfolio hobi projektov risanja: ilustracija, skecirka in portreti.' } = Astro.props;
const fullTitle = title ? `${title} · Simon Dimc` : 'Simon Dimc';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const instagram = 'https://www.instagram.com/simondimc';
---
<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={url('/favicon.ico')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header frame">
        <div class="bar">
          <a class="name" href={url('/')}>Simon Dimc</a>
          <nav>
            {Object.entries(categories).map(([slug, label]) => (
              <a class="clickable" href={url(`/${slug}/`)} aria-current={path.startsWith(`/${slug}`) ? 'page' : undefined}>{label}</a>
            ))}
            <a class="clickable" href={url('/o-meni/')} aria-current={path.startsWith('/o-meni') ? 'page' : undefined}>O meni</a>
            <a class="clickable icon" href={instagram} aria-label="Instagram" title="Instagram">
              <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="#000" d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2A5.8,5.8 0 0,1 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8A5.8,5.8 0 0,1 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4C4,18.39 5.61,20 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6C20,5.61 18.39,4 16.4,4H7.6M17.25,5.5A1.25,1.25 0 0,1 18.5,6.75A1.25,1.25 0 0,1 17.25,8A1.25,1.25 0 0,1 16,6.75A1.25,1.25 0 0,1 17.25,5.5M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/></svg>
            </a>
          </nav>
        </div>
      </header>
      <main class="content frame">
        <div class="stack"><slot /></div>
      </main>
      <footer class="site-footer frame">
        <div class="foot">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#000" d="M10.08,10.86C10.13,10.53 10.24,10.24 10.38,10C10.5,9.74 10.72,9.53 10.97,9.37C11.21,9.22 11.5,9.15 11.88,9.14C12.11,9.15 12.32,9.19 12.5,9.27C12.71,9.36 12.89,9.5 13.03,9.63C13.17,9.78 13.28,9.96 13.37,10.16C13.46,10.36 13.5,10.58 13.5,10.8H15.3C15.28,10.33 15.19,9.9 15,9.5C14.85,9.12 14.62,8.78 14.32,8.5C14,8.22 13.66,8 13.24,7.84C12.82,7.68 12.36,7.61 11.85,7.61C11.2,7.61 10.63,7.72 10.15,7.95C9.67,8.18 9.27,8.5 8.95,8.87C8.63,9.26 8.39,9.71 8.24,10.23C8.09,10.75 8,11.29 8,11.87V12.14C8,12.72 8.08,13.26 8.23,13.78C8.38,14.3 8.62,14.75 8.94,15.13C9.26,15.5 9.66,15.82 10.14,16.04C10.62,16.26 11.19,16.38 11.84,16.38C12.31,16.38 12.75,16.3 13.16,16.15C13.57,16 13.93,15.79 14.24,15.5C14.55,15.25 14.8,14.94 15,14.58C15.16,14.22 15.27,13.84 15.28,13.43H13.5C13.5,13.64 13.43,13.83 13.34,14C13.25,14.19 13.13,14.34 13,14.47C12.83,14.6 12.66,14.7 12.46,14.77C12.27,14.84 12.07,14.86 11.86,14.87C11.5,14.86 11.2,14.79 10.97,14.64C10.72,14.5 10.5,14.27 10.38,14C10.24,13.77 10.13,13.47 10.08,13.14C10.03,12.81 10,12.47 10,12.14V11.87C10,11.5 10.03,11.19 10.08,10.86M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20Z"/></svg>
          <span>{new Date().getFullYear()} Simon Dimc</span>
        </div>
      </footer>
    </div>
  </body>
</html>
<style>
  .bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px 12px; min-height: 40px; padding-block: 4px; }
  .name { font-size: 24px; text-decoration: none; }
  nav { display: flex; align-items: center; flex-wrap: wrap; column-gap: 3px; }
  .icon { padding: 2px; }
  .icon svg { display: block; }
  .foot { display: flex; align-items: center; column-gap: 3px; min-height: 30px; }
</style>
