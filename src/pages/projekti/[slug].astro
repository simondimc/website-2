---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { categories } from '../../content.config';
import { imagesFor, url } from '../../lib';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { title, category, year, summary } = project.data;
const { Content } = await render(project);
const images = imagesFor(project.id);
---
<Base title={title} description={summary}>
  <div class="section">
    <a class="back" href={url(`/${category}/`)}>← {categories[category]}</a>
    <h1 class="section-title title">{title}</h1>
    <span class="muted">{categories[category]} · {year}</span>
    <div class="text"><Content /></div>
  </div>
  {images.length === 0 && <div class="section muted">Slike bodo dodane kmalu.</div>}
  {images.length > 0 && <Gallery images={images} alt={title} />}
</Base>
<style>
  .back { display: inline-block; margin-bottom: 8px; font-size: 14px; color: #424242; text-decoration: none; }
  .back:hover { text-decoration: underline; }
  .title { font-size: 24px; font-weight: 500; margin-bottom: 0; }
  .text { margin-top: 10px; }
</style>
